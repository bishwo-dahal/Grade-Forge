# Copy to .env.screenshots in this folder (gitignored). Never commit real passwords.
#
# Local app: run Spring (8080) and Client dev (5173). Vite proxies /docs to the server.
SCREENSHOT_BASE_URL=http://127.0.0.1:5173
#
SCREENSHOT_AUTH_EMAIL=
SCREENSHOT_AUTH_PASSWORD=
# Comma-separated. Missing routes are skipped (screenshot errors logged only).
SCREENSHOT_AUTH_PATHS=/dashboard,/settings,/faculty/my-classes
