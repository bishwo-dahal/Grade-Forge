# Copy to .env and set real values. Never commit .env.
# The app loads .env automatically from the current working directory when present.
# Run from Server/:  mvnw spring-boot:run   (or  mvn spring-boot:run )
# So long as you run from Server/, no extra steps or scripts needed.

# RDS / Postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_RDS_HOST:5432/YOUR_DB_NAME
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password

# S3
CLOUD_AWS_S3_BUCKET_NAME=your-bucket-name
CLOUD_AWS_CREDENTIAL_ACCESS_KEY=AKIA...
CLOUD_AWS_CREDENTIAL_SECRET_KEY=your_secret_key
CLOUD_AWS_REGION=us-east-2

# Optional: RabbitMQ (defaults in application.properties are localhost:5672 guest/guest)
# SPRING_RABBITMQ_HOST=localhost
# SPRING_RABBITMQ_PORT=5672
# SPRING_RABBITMQ_USERNAME=guest
# SPRING_RABBITMQ_PASSWORD=guest

# Optional: Grader (for grader reports). Default in Docker is /app/grader; local dev uses ../grader from Server/
# GRADER_DIR=../grader
# GRADER_PYTHON_CMD=python3

# Optional: Plagiarism & AI / Ollama (grader LLM layer). Local dev: defaults in application.properties (enabled, localhost:11434).
# Production EC2 + Docker: deploy workflow passes these via `docker run -e` from GitHub Actions secrets (see SETUP.md).
# GRADER_LLM_AI_SIGNAL_ENABLED=true
# GRADER_LLM_AI_SIGNAL_URL=http://localhost:11434/api/generate
# GRADER_LLM_AI_SIGNAL_URL=http://host.docker.internal:11434/api/generate
# GRADER_LLM_AI_SIGNAL_MODEL=llama3
# GRADER_LLM_AI_SIGNAL_TIMEOUT_SEC=120
# Optional: cap LLM calls per report (0 = no cap).
# GRADER_LLM_AI_SIGNAL_MAX_STUDENTS=0
# Optional: LLM score term coefficient (default 0.20).
# GRADER_LLM_AI_SIGNAL_WEIGHT=0.20

# Optional: absolute path to authorship ML model file for university-admin "Download current model".
# ML_AUTHORSHIP_MODEL_PATH=/var/grade-forge/models/authorship/model.onnx

#Email Service
#spring.mail.host=smtp.example.com
#spring.mail.port=587
#spring.mail.username=Email Address
#spring.mail.password= App Key Password
#spring.mail.properties.mail.smtp.auth=true
#spring.mail.properties.mail.smtp.starttls.enable=true
